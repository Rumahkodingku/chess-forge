{
  "name": "chess-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:openings": "node scripts/build-openings.mjs",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test -c playwright.production.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run build",
    "validate:video": "node scripts/validate-video.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@mliebelt/pgn-parser": "^1.4.19",
    "@remotion/media": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/web-renderer": "^4.0.545",
    "chess.js": "^1.4.0",
    "chessground": "9.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.545",
    "sonner": "^2.0.8",
    "stockfish": "^19.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
